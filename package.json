{
  "name": "rtsp-streamer",
  "version": "1.0.0",
  "description": "Zero-dependency RTSP-to-browser streaming over WebSocket, with a WebCodecs <rtsp-player> element and React/Angular bindings — no ffmpeg, no native addons, no media server.",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html/rtsp-player.d.ts",
      "default": "./dist/html/rtsp-player.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./angular": {
      "types": "./dist/angular/angular/index.d.ts",
      "default": "./dist/angular/angular/index.js"
    },
    "./next": {
      "types": "./dist/next/next/index.d.ts",
      "default": "./dist/next/next/index.js"
    },
    "./next/client": {
      "types": "./dist/next/next/client.d.ts",
      "default": "./dist/next/next/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:assets && npm run build:cjs && npm run build:esm && npm run build:react && npm run build:angular && npm run build:next && node scripts/finalize-dist.mjs",
    "build:html": "tsc -p tsconfig.html.json",
    "build:react": "tsc -p tsconfig.react.json",
    "build:angular": "tsc -p tsconfig.angular.json",
    "build:next": "tsc -p tsconfig.next.json",
    "build:assets": "npm run build:html && node scripts/build-assets.mjs",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "examples:http": "tsx examples/http/server.ts",
    "examples:express": "tsx examples/express/server.ts",
    "examples:fastify": "tsx examples/fastify/server.ts",
    "examples:nest": "tsx --tsconfig examples/nest/tsconfig.json examples/nest/server.ts",
    "examples:rtp": "tsx examples/rtp/server.ts",
    "examples:react": "cd examples/react && npm run dev",
    "examples:angular": "cd examples/angular && npm start",
    "examples:next": "cd examples/next && npm run dev",
    "typecheck": "npm run build:assets && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.esm.json --noEmit && tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.angular.json --noEmit && tsc -p tsconfig.next.json --noEmit",
    "lint": "npm run build:assets && eslint .",
    "lint:fix": "npm run build:assets && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biswasray/rtsp-streamer.git"
  },
  "keywords": [
    "rtsp",
    "rtp",
    "websocket",
    "webcodecs",
    "h264",
    "streaming",
    "video",
    "live-video",
    "ip-camera",
    "camera",
    "player",
    "react",
    "angular",
    "zero-dependency"
  ],
  "author": "Subhasish Biswasray",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/biswasray/rtsp-streamer/issues"
  },
  "homepage": "https://github.com/biswasray/rtsp-streamer#readme",
  "peerDependencies": {
    "@angular/core": ">=17",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^19.0.0",
    "@types/react": "^19.2.2",
    "react": "^19.2.0",
    "@eslint/js": "^10.0.1",
    "@fastify/static": "^9.3.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "fastify": "^5.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
